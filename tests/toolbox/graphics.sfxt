# tests/toolbox/graphics.sfxt - the workbench's look switches (graphics.c):
# static batching builds once, culling skips what you can't see, the
# switches switch.
app   toolbox
rate  72

case batching-builds-the-scenery-once
  fails-if toolbox_scenery_rebuilds_every_frame
  wait    1s
  expect  app scenery_chunks > 5
  expect  app scenery_builds == 1               # built once, then only drawn

case culling-skips-what-is-behind-you
  fails-if toolbox_culling_ignored
  look    dir 180,0 over 0.3s                   # the row is behind you now
  wait    5f
  expect  app culled > 100

case light-switch-turns-lighting-off
  expect  app lighting == 1
  hand    R poke table.light
  wait    5f
  expect  app lighting == 0

case a-dropped-block-lands-on-the-table-with-an-impact
  fails-if toolbox_blocks_ignore_scenery
  hand    R point at table.spawn over 0.3s
  trigger R 1 over 0.1s
  wait    3f
  trigger R 0
  wait    1.5s
  expect  app impacts >= 1
  expect  app last_block_y > 0.85                # on the table, not through it

case your-hands-cast-shadows
  hand    R to table.grid offset 0,0.15,0 over 0.3s
  wait    5f
  expect  app shadows >= 1
