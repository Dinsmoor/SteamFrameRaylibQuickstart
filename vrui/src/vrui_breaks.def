// vrui break switches: BREAK(name, "what breaks"). See sfxr/include/sfxr_break.h.
BREAK(vrui_mech_lateral_leak,       "drives let off-axis hand motion leak in (pressing down / pushing sideways moves the control)")
BREAK(vrui_mech_absolute,           "drives ignore where you took hold, so grabbing makes the value jump")
BREAK(vrui_mech_no_slop,            "no break-in: the act of grabbing nudges the value")
BREAK(vrui_rotary_twist_only,       "rotary ignores where the hand is (no lazy-susan dragging, levers and cranks don't move)")
BREAK(vrui_rotary_no_twist,         "rotary ignores wrist twist")
BREAK(vrui_selector_chatter,        "selectors switch position exactly at the halfway point (no hysteresis)")
BREAK(vrui_rotary_orbit_everywhere, "rotary trusts the orbit angle even at the center, so side pushes spin it")
BREAK(vrui_hold_breaks_on_drift,    "a hold ends when the hand drifts away from the control")
BREAK(vrui_mech_stop_unwind,        "end stops don't hold the raw value, so over-turning must be unwound")
BREAK(vrui_mech_no_snap,            "selectors can rest between positions")
BREAK(vrui_mech_no_resistance,      "controls follow the hand at any speed (no weight, no speed limit, no slip)")
BREAK(vrui_mech_no_tension,         "sprung controls give no tension hum while held away from rest")
BREAK(vrui_mech_no_spring,          "sprung controls stay where they were released")
BREAK(vrui_button_ignores_shape,    "point-to-press buttons press for any hand shape")
BREAK(vrui_grab_style_ignored,      "near grabs always use the grip button, whatever vrui_style()->grab says")
BREAK(vrui_button_side_entry,       "a tip brushing in from the side presses a button")
BREAK(vrui_button_no_slide,         "a button press ends as soon as the tip drifts past the rim")
BREAK(vrui_switch_no_exit_margin,   "a switch re-arms the instant the tip leaves it, so edge jitter double-flips it")
