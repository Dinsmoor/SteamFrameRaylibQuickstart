// vrui break switches: BREAK(name, "what breaks"). See sfxr/include/sfxr_break.h.
BREAK(vrui_mech_lateral_leak,       "drives let off-axis hand motion leak in (pressing down / pushing sideways moves the control)")
BREAK(vrui_mech_absolute,           "drives ignore where you took hold, so grabbing makes the value jump")
BREAK(vrui_mech_no_slop,            "no break-in: the act of grabbing nudges the value")
BREAK(vrui_rotary_twist_only,       "rotary ignores where the hand is (no lazy-susan dragging, levers and cranks don't move)")
BREAK(vrui_rotary_no_twist,         "rotary ignores wrist twist")
BREAK(vrui_selector_chatter,        "selectors switch position exactly at the halfway point (no hysteresis)")
BREAK(vrui_rotary_orbit_everywhere, "rotary trusts the orbit angle even at the center, so side pushes spin it")
BREAK(vrui_hold_breaks_on_drift,    "a hold ends when the hand drifts away from the control")
BREAK(vrui_mech_stop_unwind,        "end stops don't hold the raw value, so over-turning must be unwound")
BREAK(vrui_mech_no_snap,            "selectors can rest between positions")
BREAK(vrui_mech_no_resistance,      "controls follow the hand at any speed (no weight, no speed limit, no slip)")
BREAK(vrui_mech_no_tension,         "sprung controls give no tension hum while held away from rest")
BREAK(vrui_mech_tension_linear,     "the tension hum ramps linearly (near-full strength just off rest)")
BREAK(vrui_mech_no_spring,          "sprung controls stay where they were released")
BREAK(vrui_button_ignores_shape,    "point-to-press buttons press for any hand shape")
BREAK(vrui_grab_style_ignored,      "near grabs always use the grip button, whatever vrui_style()->grab says")
BREAK(vrui_button_side_entry,       "a tip brushing in from the side presses a button")
BREAK(vrui_button_no_slide,         "a button press ends as soon as the tip drifts past the rim")
BREAK(vrui_switch_no_exit_margin,   "a switch re-arms the instant the tip leaves it, so edge jitter double-flips it")
BREAK(vrui_climb_fixed_world,       "handholds hold the hand but never move the player (climbing does nothing)")
BREAK(vrui_climb_no_reanchor,       "when the leading hand lets go, the other hand's stale grab point yanks the player")
BREAK(vrui_handhold_point_only,     "bars only take hold at their middle (you can't grab a rung anywhere along it)")
BREAK(vrui_loco_no_fall,            "the player floats where they are when the ground drops away")
BREAK(vrui_loco_step_any_height,    "walking into a table or wall lifts the player on top of it")
BREAK(vrui_loco_arc_floor_only,     "the teleport arc ignores surfaces and lands on the floor under them")
BREAK(vrui_loco_no_pad_snap,        "landing near a pad doesn't snap to its center or facing")
BREAK(vrui_loco_no_mantle,         "letting go with your head over a ledge drops you back down instead of onto it")
BREAK(vrui_loco_pads_only_ignored, "pads_only is ignored: you can teleport anywhere")
BREAK(vrui_events_unnamed,           "the event log shows widget ids instead of their labels")
BREAK(vrui_cord_no_rearm_margin,    "a pull cord re-arms right below its firing point, so jiggling at the bottom fires it again")
BREAK(vrui_radial_angle_from_x,     "radial menu slices are counted from 3 o'clock instead of the top, so the stick picks the wrong choice")
BREAK(vrui_radial_no_claim,         "an open radial menu doesn't claim its stick, so choosing also teleports or turns you")
BREAK(vrui_radial_keeps_last,       "letting go with the stick centered picks the last highlighted choice instead of nothing")
BREAK(vrui_follow_world_space,      "a lazy-follow HUD is kept in world space, so teleports and snap turns make it swoop after you")
BREAK(vrui_body_follows_head,       "the body estimate turns with every glance, so a belt swings whenever you look around")
BREAK(vrui_arrow_ignores_view,      "edge arrows show even when the target is in plain view")
BREAK(vrui_valve_one_hand_turns,    "a two-handed valve turns with one hand on it")
BREAK(vrui_valve_sum_not_average,   "a two-handed wheel adds the hands' swings instead of averaging them, so it turns twice as far as your hands")
BREAK(vrui_key_any_angle,           "a key goes into its slot at any angle, even held sideways")
BREAK(vrui_key_needs_regrip,        "inserting a key ends the hold, so you must let go and grab it again to turn it")
BREAK(vrui_key_stuck,               "pulling back on a key at its first stop doesn't take it out")
BREAK(vrui_loco_no_wall_fade,       "putting your head into a wall shows you its inside (no fade)")
BREAK(vrui_loco_walk_through_walls, "stick walking goes straight through walls")
BREAK(vrui_smooth_world_space,     "a smoothed held thing ignores the rig, so a teleport smears it across the world")
BREAK(vrui_wield_keeps_grab_angle, "a wielded thing stays at whatever angle it was grabbed, instead of settling into the hand by its handle")
BREAK(vrui_wield_second_hand_ignored, "a second hand on a wielded thing's handle doesn't steer it")
BREAK(vrui_wield_weightless, "wielded things all follow the hand exactly, whatever they weigh")
BREAK(vrui_wield_not_sticky, "a sticky grip drops the thing as soon as the grip loosens")
